NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production FSRS shadow backfill runner (scripts/fsrs-reconcile-production.ts).
# These are NOT used by the application itself. The production runner requires
# them; it fails closed if any are missing. FLASHLEARN_PRODUCTION_PROJECT_REF
# must also be added to the ALLOWED_PRODUCTION_PROJECT_REFS allowlist in the
# runner before it will act. The project ref is a public identifier, not a secret.
FLASHLEARN_PRODUCTION_SUPABASE_URL=
FLASHLEARN_PRODUCTION_PROJECT_REF=

