NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key for Paste Import semantic generation (server-side only, never exposed to browser)
# When absent, structured paste (TSV, Q:/A:, etc.) works normally; continuous-text paste requires this key.
GEMINI_API_KEY=

# Google Cloud configuration for Google Sheets import (browser-safe client identifiers only)
# These are NOT secrets — they are used by the browser-side Google Picker / OAuth flow.
# Production configuration should restrict the API key by allowed web origins and required APIs.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID=

# Production FSRS shadow diagnostics (scripts/fsrs-reconcile-production.ts,
# scripts/fsrs-compare-production.ts). These are NOT used by the application
# itself. The production runners require them; they fail closed if any are
# missing. CAPYSTUDY_PRODUCTION_PROJECT_REF must also be added to the
# ALLOWED_PRODUCTION_PROJECT_REFS allowlist in scripts/lib/production-identity.ts
# before any runner will act. The project ref is a public identifier, not a secret.
CAPYSTUDY_PRODUCTION_SUPABASE_URL=
CAPYSTUDY_PRODUCTION_PROJECT_REF=

# Web push (Task W3/W4): public VAPID key is browser-safe. The private key
# and subject live in Supabase secrets for the send-reminders edge function,
# never in this file or the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@capystudy.app

# Local development safety: the app refuses the configured production Supabase
# project by default. Set to 1 only for deliberate, read-only diagnostics.
NEXT_PUBLIC_ALLOW_PRODUCTION_SUPABASE_FROM_LOCAL=

# TEST ONLY — set exclusively by the local E2E runner. Never enable in production.
CAPYSTUDY_CLASSIFIER_MOCK=
CAPYSTUDY_CLASSIFIER_COUNT_FILE=
CAPYSTUDY_GENERATION_MOCK=
CAPYSTUDY_GENERATION_COUNT_FILE=
CAPYSTUDY_GENERATION_MOCK_FAIL_FILE=

