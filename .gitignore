# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/e2e/.auth/

# next.js
/.next/
/out/
/public/sw.js
/public/sw.js.map

# production
/build

# misc
.DS_Store
*.pem

