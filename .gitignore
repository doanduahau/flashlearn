/reports/sbom.cdx.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli transient state
/supabase/.branches/
/supabase/.temp/
